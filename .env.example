# Copy this file to .env and fill in real values. Never commit .env.

DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated, scheme included - required in production for CSRF to work
# over HTTPS, e.g. https://your-app.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=

DB_NAME=bikers_community
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# Path to a CA certificate file - required by managed providers (e.g. Aiven)
# that enforce TLS on MySQL connections. Leave blank for local MySQL.
DB_SSL_CA=

# Email (OTP delivery). For local development leave EMAIL_BACKEND as console
# so OTPs print to the terminal instead of sending real email.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Bikers Community <no-reply@bikerscommunity.local>
